# ── 복사해서 .env 로 만들고 사내 값으로 채우세요 ──────────────────────────
# cp .env.example .env
#
# 변수 이름은 사내 config.py 와 동일합니다.

# =========================================================================
# LLM 게이트웨이 (OpenAI 호환)
# =========================================================================
# _llm.get_llm 이 .format(api_base="hcp") 으로 채워 씁니다
API_BASE_TEMPLATE=http://hcp.llm.skhynix.com/v1

# 모델 목록 조회 경로 (base_url 뒤에 붙습니다)
MODEL_LIST_ENDPOINT=/models

# 게이트웨이 인증 키. 사내 게이트웨이는 키를 요구하지 않으므로 비워두면 됩니다.
# (OpenAI SDK 가 빈 키를 거부해서 코드가 내부적으로 'EMPTY' 로 대체합니다)
LLM_GATEWAY_API_KEY=

# ── 사내망 밖에서 돌릴 때만 (로컬 ollama 등) ──────────────────────────────
# 비워두면 사내 기본값(GaiA-LLM-Latest)이 그대로 쓰입니다. 사내에서는 건드리지 마세요.
#
# ollama 예시 — ollama 는 OpenAI 호환 엔드포인트를 11434 포트로 제공합니다.
#   API_BASE_TEMPLATE=http://localhost:11434/v1
#   LLM_GATEWAY_API_KEY=ollama
#   DEFAULT_MODEL=glm4:latest
#   AVAILABLE_MODELS=glm4:latest,llama3.2:latest
#
# 주의: 이 프로젝트의 모든 판단은 구조화 출력(response_format=json_schema)을
#       씁니다. 모델이 그걸 못 하면 라우팅부터 실패합니다.
#       `python tools/check_llm.py` 로 먼저 확인하세요.
DEFAULT_MODEL=
AVAILABLE_MODELS=

# =========================================================================
# 로그
# =========================================================================
# 일별 jsonl 로그 폴더. 경로의 마지막 폴더명이 env 이름으로 쓰입니다.
#   logs/{LOG_DIR 폴더명}/{YYYY-MM}/{YYYY-MM-DD}.jsonl
LOG_DIR=./devLogs

# =========================================================================
# 서버
# =========================================================================
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit 데모 UI 가 붙을 백엔드 주소
API_BASE_URL=http://localhost:8000/llm/api

# =========================================================================
# HITL 루프 가드
# =========================================================================
MAX_COLLECT=5
MAX_VALIDATE=3
MAX_HOPS=3
