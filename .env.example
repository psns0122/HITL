# ── 복사해서 .env 로 만들고 사내 값으로 채우세요 ──────────────────────────
# cp .env.example .env
#
# 변수 이름은 사내 기존 프로젝트(pptx-vision-rag)와 동일하게 맞췄습니다.
# → 거기 쓰던 .env 의 LLM_GATEWAY_* / LLM_CHAT_MODEL 값을 그대로 복사하면 됩니다.
# (구 이름 OPENAI_BASE_URL / OPENAI_API_KEY / MODEL_NAME 도 폴백으로 인식합니다)

# =========================================================================
# LLM
# =========================================================================
# 사내 LLM 게이트웨이 (OpenAI 호환 엔드포인트)
# ChatOpenAI 가 여기에 /chat/completions 를 붙여 호출합니다.
LLM_GATEWAY_BASE_URL=http://hcp.llm.skhynix.com/v1

# 게이트웨이 인증 키. 사내 게이트웨이는 키를 요구하지 않으므로 비워두면 됩니다.
# (OpenAI SDK 가 빈 키를 거부해서 코드가 내부적으로 'EMPTY' 로 대체합니다)
LLM_GATEWAY_API_KEY=

# 라우팅/의도추출/최종답변에 쓸 채팅 모델
#   대안: glm-5.1 / qwen3-235b-a22b-instruct-2507 / qwen3.5-297b-a17b / gpt-oss-120b
LLM_CHAT_MODEL=GaiA-LLM-Latest

TEMPERATURE=0
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# =========================================================================
# 로그
# =========================================================================
# 저장 경로: logs/{이 폴더명}/{YYYY-MM}/{YYYY-MM-DD}.jsonl
LOG_DIR=./devLogs

# =========================================================================
# 서버 / 프론트
# =========================================================================
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit 이 바라보는 API 주소
API_BASE_URL=http://localhost:8000/llm/api

# =========================================================================
# HITL 루프 가드
# =========================================================================
MAX_COLLECT=5      # 같은 파라미터를 사용자에게 되묻는 최대 횟수
MAX_VALIDATE=3     # 유효성 검증 재시도 최대 횟수
MAX_HOPS=3         # 동료 에이전트에게 값을 위임(needs-핸드오프)하는 최대 왕복 횟수

# =========================================================================
# 디버그
# =========================================================================
# 중간 에이전트의 토큰 단위 스트리밍(thinking 채널). 기본 off
#   주의: interrupt 하는 노드에서 켜면 재개 시 토큰이 중복 방출될 수 있습니다.
SHOW_THINKING_TOKENS=0

DEBUG=false
