# ── 복사해서 .env 로 만들고 사내 값으로 채우세요 ──────────────────────────
# cp .env.example .env

# 1=LLM 없이 규칙 기반 목업으로 동작(데모/HITL 검증용), 0=실제 LLM 사용
FAKE_LLM=1

# 사내 OpenAI 호환 endpoint (FAKE_LLM=0 일 때 필수)
OPENAI_BASE_URL=https://your-internal-gateway/v1
OPENAI_API_KEY=sk-your-internal-key
MODEL_NAME=gpt-4o
TEMPERATURE=0

# 로그 저장 폴더명 (logs/{이 폴더명}/{YYYY-MM}/{YYYY-MM-DD}.jsonl)
LOG_DIR=./devLogs

# FastAPI 서버
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit 이 바라보는 API 주소
API_BASE_URL=http://localhost:8000/llm/api

# HITL 루프 가드
MAX_COLLECT=5
MAX_VALIDATE=3
MAX_HOPS=3

# 중간 에이전트 토큰 스트리밍(thinking 채널) — 현재 미구현 훅, 0 유지
SHOW_THINKING_TOKENS=0
